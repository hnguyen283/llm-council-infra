OPTION_NAME=prod-full-local-observability-collector-canary
OPTION_KIND=compose-stack
PUBLIC_SCHEME=http
PUBLIC_HOST=localhost
PUBLIC_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
UI_RUNTIME_MODE=nginx-static
PRODUCTION_LIKE_UI=true
GRAPHRAG_MODE=enabled
GRAPHRAG_ENABLED=true
EDGE_CONTAINER_PORT=8080
LOG_DIR_HOST=../logs
LOCAL_OBS_HOST_BIND=127.0.0.1

# This is the only opt-in GraphRAG telemetry path. It resolves only on the
# private Collector-ingest network; workloads never receive a Zipkin/OpenLIT
# endpoint in this option.
OTEL_EXPORTER_OTLP_ENDPOINT_GRPC=otel-collector:4317

# The C3 Java canary is opt-in and is the sole core service on Collector ingress.
OTEL_EXPORTER_OTLP_ENDPOINT_ORCHESTRATOR=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL_ORCHESTRATOR=grpc

# C3.2A edge and C3.2B provider-worker canaries use authenticated OTLP/HTTP;
# application-docker.yml appends the standard /v1/traces path.
OTEL_EXPORTER_OTLP_ENDPOINT_API_GATEWAY=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL_API_GATEWAY=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT_GEMINI=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL_GEMINI=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT_GPT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL_GPT=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT_LOCAL_AI=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL_LOCAL_AI=http/protobuf